#!/usr/bin/env bash
# Configures Nginx to redirect /redirect_me to a YouTube video with 301

# Install nginx if not installed
apt-get update -y
apt-get install nginx -y

# Insert redirect inside the first server block in default site
awk '
/server {/ { print; inside=1; next }
inside && /}/ { print "    location /redirect_me/ { return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4; }"; inside=0 }
{ print }
' /etc/nginx/sites-available/default > /tmp/default && mv /tmp/default /etc/nginx/sites-available/default

# Test nginx config
nginx -t

# Reload nginx (works without systemd)
nginx -s reload
