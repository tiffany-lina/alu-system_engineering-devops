#!/usr/bin/env bash
# Ensure Nginx runs on port 80 (IPv4 & IPv6), stopping Apache or Nginx if needed

# Fix default site to listen on IPv4 and IPv6
if ! grep -q "^listen 80" /etc/nginx/sites-enabled/default; then
    sed -i "s|listen \[::\]:80 default_server;|listen 80 default_server;\nlisten [::]:80 default_server;|" /etc/nginx/sites-enabled/default
fi
if ! grep -q "^listen \[::\]:80" /etc/nginx/sites-enabled/default; then
    sed -i "/listen 80 default_server;/a listen [::]:80 default_server;" /etc/nginx/sites-enabled/default
fi

# Kill any process using port 80 (Apache or old Nginx)
pkill apache2 >/dev/null 2>&1 || true
pkill nginx >/dev/null 2>&1 || true

# Start Nginx
nginx
