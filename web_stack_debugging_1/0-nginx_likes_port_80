#!/usr/bin/env bash
# This script installs Nginx, configures it to listen on port 80, and starts it in a container

# 1. Install Nginx if missing
if ! command -v nginx >/dev/null 2>&1; then
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y nginx
fi

# 2. Configure default site to listen on port 80
cat >/etc/nginx/sites-available/default <<'EOF'
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;

    server_name _;

    location / {
        try_files $uri $uri/ =404;
    }
}
EOF

# 3. Ensure the default site is enabled
ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default

# 4. Test Nginx configuration
nginx -t

# 5. Stop Nginx if running (cleanup)
nginx -s stop >/dev/null 2>&1 || true

# 6. Start Nginx
nginx

# 7. Wait a moment for Nginx to be fully up
sleep 1

# 8. Verify HTTP 200
status=$(curl -s -o /dev/null -w "%{http_code}" 0:80)
if [ "$status" -eq 200 ]; then
    echo "Nginx is running and serving HTTP 200 on port 80 ✅"
else
    echo "Nginx failed to serve HTTP 200 on port 80 ❌"
fi
