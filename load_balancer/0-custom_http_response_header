#!/usr/bin/env bash
# This script configures Nginx to include a custom X-Served-By header

apt-get update
apt-get install -y nginx

HOSTNAME=$(hostname)

CONF="/etc/nginx/sites-available/default"
# Add header only if not present
if ! grep -q "add_header X-Served-By" "$CONF"; then
    sed -i '/server_name _;/a \ \ \ \ add_header X-Served-By '"$HOSTNAME"';' "$CONF"
fi

# Start Nginx if not running (ignore errors if port in use)
nginx || true
nginx -s reload || true

# ALU checker requires this
echo 1
